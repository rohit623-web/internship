# Rename this file to .env and fill in your real values.
# Never commit the real .env file to GitHub.

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ecommerce_db
DB_PORT=3306

# Flask
SECRET_KEY=change_this_to_a_random_secret_string
JWT_SECRET_KEY=change_this_to_another_random_secret_string

FLASK_ENV=development
